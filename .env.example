# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=medical
MYSQL_PASSWORD=medical123
MYSQL_DATABASE=medical

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Qdrant =====
QDRANT_URL=http://127.0.0.1:6333

# ===== JWT（生产必须换 >=32 字节随机串） =====
JWT_SECRET=change-me-in-production-use-32-bytes-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 网关限流（滑动窗口：单身份窗口内 QPS / 窗口毫秒） =====
RATE_LIMIT_QPS=10
RATE_LIMIT_WINDOW_MS=1000

# ===== 日志（true 输出结构化 JSON，每行带 traceId） =====
LOG_JSON=true

# ===== 缓存 TTL（秒） =====
CACHE_EMBEDDING_TTL=604800
CACHE_RAG_TTL=60

# ===== 大模型（开发期 provider=mock，填入 key 后切换） =====
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VL_API_KEY=
VL_MODEL=

# ===== 存储路径（相对路径按项目根解析） =====
UPLOAD_DIR=./data/uploads
RAG_DOC_DIR=./data/rag_docs

# ===== Embedding / RAG =====
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=64
RAG_TOP_K=5
RAG_MIN_SCORE=0.18

# ===== RAG 入库（true 走 Celery，需启动 worker） =====
RAG_INGEST_ASYNC=false
